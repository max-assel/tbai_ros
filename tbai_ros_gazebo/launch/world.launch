<?xml version="1.0" encoding="utf-8"?>
<launch>
    <!-- Required arguments -->
    <arg name="controllers_ns"/>
    <arg name="controllers_args"/>
    <arg name="config_file"/>
    <arg name="description_name"/>
    <arg name="description_file"/>

    <!-- Optional gazebo arguments -->
	<arg name="gui"					     default="true"/>
	<arg name="x" 					   	 default="0.0"/>
	<arg name="y" 					     default="0.0"/>
	<arg name="z" 					     default="3.0"/>
	<arg name="world"					 default="normal"/>
	<arg name="paused"					 default="false"/>
    <arg name="use_sim_time"             default="true"/>
    <!-- Ground-truth simulation state uses Gazebo world coordinates in odom. -->
    <arg name="terrain_frame"            default="odom"/>

    <!-- Upload some data to ROS param server -->
    <rosparam file="$(arg config_file)" command="load"/>

    <!-- gazebo_ros sources the active Gazebo setup script itself. Inheriting a
         second installation's media causes duplicate Ogre resources at startup.
         Scope this to Gazebo so other nodes retain their environment. -->
    <group>
        <env name="GAZEBO_RESOURCE_PATH" value=""/>
        <include file="$(find gazebo_ros)/launch/empty_world.launch">
            <arg name="world_name" value="$(find tbai_ros_gazebo)/launch/worlds/$(arg world)/$(arg world).world"/>
            <arg name="use_sim_time" value="$(arg use_sim_time)"/>
            <arg name="gui" value="$(arg gui)"/>
            <arg name="paused" value="$(arg paused)"/>
            <arg name="server_required" value="true"/>
        </include>
    </group>

	<!-- Load gazebo description -->
	<param name="$(arg description_name)" command="$(find xacro)/xacro --inorder $(arg description_file)" />

    <!-- Spawn robot -->
    <node name="spawn_urdf" pkg="gazebo_ros" type="spawn_model"
	   args="-param $(arg description_name) -urdf -x $(arg x) -y $(arg y) -z $(arg z) -model robot"/>

    <!-- Load joint controllers -->
	<node name="controller_spawner" pkg="controller_manager" type="spawner"
      respawn="false" output="screen" ns="$(arg controllers_ns)" args="$(arg controllers_args)"/>
	<node pkg="tbai_ros_gazebo"
      type="terrain_publisher"
      name="terrain_publisher"
      output="screen">
		<param name="world_file"
				value="$(find tbai_ros_gazebo)/launch/worlds/$(arg world)/$(arg world).world"/>
		<param name="frame_id" value="$(arg terrain_frame)"/>
	</node>
</launch>
