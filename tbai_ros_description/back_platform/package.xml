<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>back_platform</name>
  <version>1.0.0</version>
  <description>
    URDF Description package for back_platform robot.
    This package contains configuration data, 3D models and launch files
    for back_platform robot visualization and simulation.
  </description>
  
  <maintainer email="rcao73@gatech.edu">TODO</maintainer>
  <license>BSD-3-Clause</license>
  
  <author email="rcao73@gatech.edu">TODO</author>
  
  <buildtool_depend>ament_cmake</buildtool_depend>
  
  <exec_depend>robot_state_publisher</exec_depend>
  <exec_depend>joint_state_publisher</exec_depend>
  <exec_depend>joint_state_publisher_gui</exec_depend>
  <exec_depend>rviz2</exec_depend>
  <exec_depend>gazebo_ros_pkgs</exec_depend>
  <exec_depend>xacro</exec_depend>
  
  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>
  
  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>